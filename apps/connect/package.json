{
  "name": "@varys/connect",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "description": "The Varys Bridge Helper — pairs your machine to Varys and launches your own Claude when you press Run.",
  "bin": {
    "varys-connect": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@varys/review-contract": "workspace:*",
    "tsx": "^4.19.2",
    "vitest": "^3.2.6"
  }
}
